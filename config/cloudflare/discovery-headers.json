{
  "ref": "docs_agent_discovery_headers",
  "description": "Advertise Celestia docs agent resources",
  "expression": "http.host eq \"docs.celestia.org\"",
  "action": "rewrite",
  "action_parameters": {
    "headers": {
      "link": {
        "operation": "add",
        "value": "</.well-known/api-catalog>; rel=\"api-catalog\", </llms.txt>; rel=\"describedby\"; type=\"text/plain\", </SKILL.md>; rel=\"describedby\"; type=\"text/markdown\""
      }
    }
  },
  "enabled": true
}
